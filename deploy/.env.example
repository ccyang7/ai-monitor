# 生产环境配置模板
#
# 用法：在服务器项目根目录执行
#   cp deploy/.env.example .env.production
#   chmod 600 .env.production
#
# 它同时承担两件事：
#   1. 给 docker compose 提供变量插值（POSTGRES_PASSWORD）
#   2. 通过 env_file 注入 backend 容器的应用配置
#
# Compose 不会自动读 .env.production，项目里的所有命令统一走 deploy/compose.sh，
# 它已经带上了 --env-file .env.production。
#
# 本地开发用的是 ai-monitor-backend/.env.development
# （模板 ai-monitor-backend/.env.example），两者不要混用，
# 也不要把本地文件传到服务器。

# ===== 部署层（docker compose 读取） =====
# openssl rand -hex 24
# 只用十六进制字符：密码里出现 @ : / # 会破坏下面自动拼出的 DATABASE_URL
POSTGRES_PASSWORD=CHANGE_ME_HEX

# ===== 应用层（backend 读取） =====
APP_NAME=AI Monitor API

# development / production
# production 会强制 DEBUG=false，并拒绝连接 ai_monitor_test 测试库
APP_ENV=production

# 生产必须 false：
#   true 会把每一条 SQL 回显到日志里，并且弱 JWT 密钥只警告、不拒绝启动
DEBUG=false

# DATABASE_URL 不要写在生产配置里。
# docker-compose.yml 会用 POSTGRES_PASSWORD 自动拼出
# postgresql+psycopg://ai_monitor:密码@postgres:5432/ai_monitor
# 本地开发才需要自己写，见 ai-monitor-backend/.env.example。

# python -c "import secrets; print(secrets.token_urlsafe(48))"
# 至少 32 字节；还是占位符或太短时，DEBUG=false 下后端会拒绝启动
JWT_SECRET_KEY=CHANGE_ME_LONG_RANDOM

# 登录有效期（分钟），默认 7 天
ACCESS_TOKEN_EXPIRE_MINUTES=10080
MAX_PROJECTS_PER_USER=3

# 异常判定阈值，一般不用改
TOKEN_ANOMALY_RATIO=5.0
LATENCY_ANOMALY_RATIO=3.0
ERROR_RATE_THRESHOLD=0.2
BASELINE_MIN_SAMPLES=10

# AI 助手：不填 Key 也能启动，聊天接口返回 503，其他功能不受影响
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash
LLM_TEMPERATURE=0.3
ASSISTANT_TIMEZONE=Asia/Shanghai
ASSISTANT_MAX_TOOL_ROUNDS=10

# 联网搜索工具，不填则助手没有联网能力
TAVILY_API_KEY=
