# 配置模板：复制为 .env 后按需修改。
# .env 已被 .gitignore 忽略（含真实密码/密钥），本文件只含变量名，需要提交。

APP_NAME=AI Monitor API
DEBUG=true

# ---------------- 数据库（PostgreSQL，跑在虚拟机上） ----------------
# 把下面这行里的两个占位符换掉：
#   CHANGE_ME_PASSWORD → 虚拟机上创建 ai_monitor 用户时设的密码
#   CHANGE_ME_VM_IP    → 虚拟机 IP（在虚拟机上用 ip addr 查）
# 改完形如：
#   DATABASE_URL=postgresql+psycopg://ai_monitor:mypass123@192.168.56.10:5432/ai_monitor
#
# 注意：这里刻意不用 ${...} 写占位符 —— .env 的解析器会把 ${XXX} 当成变量引用，
# 引用的变量不存在时会静默替换成空字符串，反而难排查。
DATABASE_URL=postgresql+psycopg://ai_monitor:CHANGE_ME_PASSWORD@CHANGE_ME_VM_IP:5432/ai_monitor

# ---------------- 认证（阶段 3 第二步才会用到） ----------------
# JWT 签名密钥。生成一个随机值贴进来：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_RANDOM_SECRET
