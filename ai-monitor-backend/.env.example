# 本地开发配置模板：复制为 ai-monitor-backend/.env.development 后按需修改。
#
#   cp ai-monitor-backend/.env.example ai-monitor-backend/.env.development
#
# 生产环境用的是项目根目录的 .env.production（模板 deploy/.env.example），
# 两者不要混用，也不要把本地这份传到服务器。
#
# .env.development 已被 .gitignore 忽略（含真实密码/密钥），本文件只含变量名，需要提交。

APP_NAME=AI Monitor API
# 后端按操作系统里的 APP_ENV 选择加载哪个文件；
# 这里的值必须与之一致，不一致会拒绝启动
APP_ENV=development
DEBUG=true

# ---------------- 数据库（PostgreSQL，跑在虚拟机上） ----------------
# 把下面这行里的两个占位符换掉：
#   CHANGE_ME_PASSWORD → 虚拟机上创建 ai_monitor 用户时设的密码
#   CHANGE_ME_VM_IP    → 虚拟机 IP（在虚拟机上用 ip addr 查）
# 改完形如：
#   DATABASE_URL=postgresql+psycopg://ai_monitor:mypass123@192.168.56.10:5432/ai_monitor
#
# 注意：这里刻意不用 ${...} 写占位符 —— .env.development 的解析器会把 ${XXX} 当成变量引用，
# 引用的变量不存在时会静默替换成空字符串，反而难排查。
#
# 生产环境不要写这一项：docker compose 会注入容器内的连接串。
DATABASE_URL=postgresql+psycopg://ai_monitor:CHANGE_ME_PASSWORD@CHANGE_ME_VM_IP:5432/ai_monitor

# ---------------- 认证 ----------------
# JWT 签名密钥。生成一个随机值贴进来：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# DEBUG=true 时密钥弱只警告；DEBUG=false 时会拒绝启动。
JWT_SECRET_KEY=CHANGE_ME_RANDOM_SECRET

ACCESS_TOKEN_EXPIRE_MINUTES=10080
MAX_PROJECTS_PER_USER=3

# ---------------- 异常判定阈值 ----------------
TOKEN_ANOMALY_RATIO=5.0
LATENCY_ANOMALY_RATIO=3.0
ERROR_RATE_THRESHOLD=0.2
BASELINE_MIN_SAMPLES=10

# ---------------- AI 分析助手 ----------------
# 平台统一配置一个 Key，所有用户共用，不需要每个用户自己配。
# 申请地址：https://platform.deepseek.com/api_keys
# 不填也能启动：助手接口会返回 503，平台其他功能不受影响。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash
LLM_TEMPERATURE=0.3
ASSISTANT_TIMEZONE=Asia/Shanghai
ASSISTANT_MAX_TOOL_ROUNDS=10
# 联网搜索（工具 search_web 用）。申请地址：https://app.tavily.com/home
# 不填也能启动：只是模型没有联网能力，问价格时会如实说明
TAVILY_API_KEY=

# ---------------- 验收脚本的测试库 ----------------
# scripts/check_*.py 默认连 ai_monitor_test 库，库名由 DATABASE_URL 自动替换得到，
# 不需要写在这里。
#
# 测试库不在同一台机器时，用 shell 环境变量临时覆盖（注意：写在 .env.development 里
# 脚本读不到，脚本读的是操作系统环境变量）：
#   TEST_DATABASE_URL=postgresql+psycopg://... uv run python scripts/check_api.py
